{
  "name": "paraware",
  "version": "0.1.0",
  "private": true,
  "description": "Paraware - Woreda 04 citizen reporting and authority response platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "seed": "node server/seed.js --force"
  },
  "dependencies": {
    "alasql": "^4.22.2",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "vite": "^8.3.6"
  }
}
